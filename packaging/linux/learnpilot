#!/usr/bin/env sh
set -eu

install_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
port=${LEARNPILOT_PORT:-3081}
node_bin="$install_dir/runtime/node/node_modules/@deepseek-ai/dsh/lib/bin.js"
if command -v node >/dev/null 2>&1 && [ -f "$node_bin" ]; then
  exec node "$node_bin" --profile web --port "$port" --no-open "$@"
fi
exec "$install_dir/deepseek-harness-sdk-runtime-linux-x64" --profile web --port "$port" --no-open "$@"
